 "cards": [
  {
   "dot": "amber",
   "title": "异常路径（终止）",
   "items": [
    "静默超时/流错误走 completeInterrupted：只写记忆与审计，不写语义缓存",
    "降级提示直接返回，避免把中断提示缓存成答案"
   ]
  },
  {
   "dot": "emerald",
   "title": "收尾顺序（异步，不阻塞回答）",
   "items": [
    "记忆写回 → 审计事件 → 正/负缓存写入，全部在回答产出后执行",
    "摘要超阈值时后台滚动压缩，不占请求路径"
   ]
  }
 ]
