# 本地开发环境变量模板 —— 复制为 .env 后填写真实值(.env 已被 .gitignore 覆盖, 不要提交)
#   cp .env.example .env
#
# ⚠ 两份文件分工不同, 别指望一份管两边:
#   .env                    → 只被 `docker compose` 读取(起 MySQL/Qdrant 用)。
#                             Spring Boot **不读** .env, 应用侧填了也不会生效。
#   application-local.yaml  → 应用自己的本地配置(模块根目录, 同样已 gitignore), 由
#                             application.yaml 的 spring.config.import(optional) 加载。
#                             **IDEA 里点启动要配的口令写在这里**, 省掉 Run Configuration 的环境变量。
# 命令行启动也可以用 export DB_PASSWORD=xxx(但 IDEA 运行配置不继承 shell 变量)。
#
# MySQL root 口令: 同时用于 docker-compose 建容器与应用连接(两处必须一致)
MYSQL_ROOT_PASSWORD=change-me-locally
DB_PASSWORD=change-me-locally

# 数据库地址与账号(默认对应 docker-compose 的 MySQL)
# DB_URL=jdbc:mysql://localhost:3306/ai_agent_db?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&createDatabaseIfNotExist=true
DB_USERNAME=root

# 大模型与向量库(生产必须注入, 否则对话/入库能力降级)
DASHSCOPE_API_KEY=
QDRANT_API_KEY=

# JWT 签名密钥(≥32 字节随机串; 留空时本地自动生成一次性密钥, prod 留空直接拒绝启动)
# 生成例: openssl rand -base64 48
JWT_SECRET=

# 演示数据播种出的管理员初始口令(生产请保持 app.demo.seed-enabled=false)
DEMO_ADMIN_PASSWORD=
